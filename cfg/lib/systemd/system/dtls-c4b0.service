[Unit]
Description=DTLS proxy that uses a range of IP addresses/ports as an alternative to connection ids.
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
User=masquerade
Restart=always
Environment=RUST_BACKTRACE="full"
Environment=RUST_LOG="trace"
WorkingDirectory=/opt/masquerade
ExecStart=/opt/masquerade/bin/dtls-proxy -i dtls-c4b0 -e [2a01:4ff:1f0:7e46::1]:9899 -r [2a01:4ff:1f0:7e46::1]:4666 -c cert-c4b0.pem
